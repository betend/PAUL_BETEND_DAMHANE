<UserControl x:Class="PAUL_BETEND_DAMHANE.UCRecapitulatif"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PAUL_BETEND_DAMHANE"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid x:Name="gridUCCatalogue" OpacityMask="Black">
        <Rectangle x:Name="rectFondBandeauOnglet" HorizontalAlignment="Center" Height="41" VerticalAlignment="Top" Width="800" Fill="#FF1E1E1E" Margin="0,74,0,0"/>
        <Button x:Name="butOngletCommandes" Content="Commandes" HorizontalAlignment="Left" Margin="202,85,0,0" VerticalAlignment="Top" Background="Transparent" FontFamily="Garamond" Foreground="#FFF5E6D3" BorderBrush="Transparent" FontSize="16" Click="butOngletCommandes_Click"/>
        <Button x:Name="butOngletCatalogue" Content="Catalogue" HorizontalAlignment="Center" Margin="0,85,0,0" VerticalAlignment="Top" Background="Transparent" FontFamily="Garamond" Foreground="#FFF5E6D3" BorderBrush="Transparent" FontSize="16" Click="butOngletCatalogue_Click"/>
        <Button x:Name="butOngletPanier" Content="Panier" HorizontalAlignment="Left" Margin="522,85,0,0" VerticalAlignment="Top" Background="Transparent" FontFamily="Garamond" Foreground="#FFF5E6D3" BorderBrush="Transparent" FontSize="16" Click="butOngletPanier_Click"/>
        <Image x:Name="iconUtilisateur" Margin="0,10,10,0" Source="/Icon/utilisateur.png" Stretch="Fill" HorizontalAlignment="Right" Width="50" Height="50" VerticalAlignment="Top"/>
        <Label x:Name="labNomUtilisateur" Content="Un nom" HorizontalAlignment="Left" Margin="740,56,0,0" VerticalAlignment="Top" Background="{x:Null}" Foreground="#FFF5E6D3" FontFamily="Garamond"/>
        <Button x:Name="butAjouterAuPanier" Content="Ajouter au panier" HorizontalAlignment="Left" Margin="613,318,0,0" VerticalAlignment="Top" Background="#FF1E1E1E" FontFamily="Garamond" Foreground="#FFF5E6D3" BorderBrush="Transparent" FontSize="16"  Width="134"/>

        <DataGrid x:Name="dgRecapitulatif"   IsReadOnly="True" ItemsSource="{Binding CommandeEnCours.LesLignesCommande}"  Margin="-2,233,279,0" AutoGenerateColumns="False" BorderBrush="Black" Background="{x:Null}" Height="215"  Width ="500" VerticalAlignment="Top"   >
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nom" Binding="{Binding UnProduit.UneRecette.Recette_nom, ValidatesOnExceptions=true}" Width="*"/>
                <DataGridTemplateColumn Header="Qté">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="-" Click="BtnMoins_Click" Width="25" Background="Black" Foreground="White"/>
                                <TextBlock Text="{Binding Quantite}" Margin="8,0" VerticalAlignment="Center"/>
                                <Button Content="+" Click="BtnPlus_Click" Width="25" Background="Black" Foreground="White"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>


                <DataGridTextColumn Header="Nb parts" Binding="{Binding UnProduit.Nb_parts, ValidatesOnExceptions=true}" Width="*"/>
                <DataGridTextColumn Header="PrixUnitaire" Binding="{Binding UnProduit.Prix, ValidatesOnExceptions=true}" Width="*"/>

                <DataGridTextColumn Header="Sous_Total" Binding="{Binding Sous_total, ValidatesOnExceptions=true}" Width="*"/>
                <DataGridTemplateColumn Header="">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Click="BtnSupprimer_Click" ToolTip="Supprimer" Width="30" Height="30" FontFamily="Segoe MDL2 Assets" Content="&#xE74D;" Background="Black" Foreground="White" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#FF1E1E1E"/>
                    <Setter Property="Foreground" Value="#FFF5E6D3"/>
                    <Setter Property="FontFamily" Value="Garamond"/>
                    <Setter Property="FontSize" Value="20"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>


                </Style>
            </DataGrid.ColumnHeaderStyle>

        </DataGrid>
        <Label x:Name="labTitreCatalogue" Content="Récapitulatif de la commande" HorizontalAlignment="Center" Margin="0,132,0,0" VerticalAlignment="Top" Background="{x:Null}" Foreground="Black" FontFamily="Georgia" FontSize="30"/>
        <Button x:Name="butLogOut"  HorizontalAlignment="Left" Margin="765,80,0,0" VerticalAlignment="Top" Height="30" Width="24" BorderBrush="{x:Null}" RenderTransformOrigin="0.417,0.425" Click="butLogOut_Click">
            <Button.Background>
                <ImageBrush ImageSource="/se-deconnecter.png"/>
            </Button.Background>
        </Button>

    </Grid>
</UserControl>
