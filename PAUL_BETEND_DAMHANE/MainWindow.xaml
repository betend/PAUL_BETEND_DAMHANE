<Window x:Name="mainWindow" x:Class="PAUL_BETEND_DAMHANE.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PAUL_BETEND_DAMHANE"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Viewbox x:Name="vbMainWindow">
        <Grid x:Name="gridMainWindow" Background="#FFF5E6D3">

            <Rectangle x:Name="rectEntete" Height="74" Stroke="Black" Width="800" Fill="Black" Margin="0,0,0,379"/>
            <Image x:Name="imgLogo" Source="/Images/LogoPaul.png" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Top" Height="74" Width="74"/>
            <ContentControl x:Name="FondEcran" Content="FondEcran"/>
        </Grid>
    </Viewbox>
</Window>
