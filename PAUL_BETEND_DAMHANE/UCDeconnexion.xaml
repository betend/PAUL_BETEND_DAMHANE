             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PAUL_BETEND_DAMHANE"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Label x:Name="labDeconnexion" Content="Vous avez été déconnecté avec succès" HorizontalAlignment="Center" Margin="0,150,0,0" VerticalAlignment="Top" FontFamily="Georgia" Height="61" Width="610" FontStyle="Italic" FontSize="36"/>
        <Button x:Name="butContinuer" Content="Continuer" HorizontalAlignment="Center" Margin="0,273,0,0" VerticalAlignment="Top" BorderBrush="Black" Background="Black" FontFamily="Garamond" Foreground="White" Height="50" Width="314" FontSize="36" RenderTransformOrigin="0.239,0.58" Click="butContinuer_Click"/>

    </Grid>
