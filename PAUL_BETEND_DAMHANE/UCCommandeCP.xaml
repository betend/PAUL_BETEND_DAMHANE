<UserControl x:Class="PAUL_BETEND_DAMHANE.UCCommandeCP"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PAUL_BETEND_DAMHANE"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <DataGrid x:Name="dgCommandeCP"   IsReadOnly="True" ItemsSource="{Binding LesCommandes}"  Margin="100,261,100,0" AutoGenerateColumns="False" BorderBrush="Black" Background="{x:Null}" Height="215" Width ="600" VerticalAlignment="Top"    >
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nom client" Binding="{Binding UnClient.Nom, ValidatesOnExceptions=true}" Width="*"/>
                <DataGridTextColumn Header="Date_retrait" Binding="{Binding Date_retrait, ValidatesOnExceptions=true}" Width="*"/>
                <DataGridTextColumn Header="Catégorie événement" Binding="{Binding UneCategorie_evenement.Categorie_evenement_nom, ValidatesOnExceptions=true}" Width="200"/>
                <DataGridTextColumn Header="Statut" Binding="{Binding Est_prete, ValidatesOnExceptions=true}" Width="*"/>

            </DataGrid.Columns>
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#FF1E1E1E"/>
                    <Setter Property="Foreground" Value="#FFF5E6D3"/>
                    <Setter Property="FontFamily" Value="Garamond"/>
                    <Setter Property="FontSize" Value="20"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>


                </Style>
            </DataGrid.ColumnHeaderStyle>

        </DataGrid>

    </Grid>
</UserControl>
