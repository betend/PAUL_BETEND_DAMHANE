<UserControl x:Class="PAUL_BETEND_DAMHANE.UCCommandeCP"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PAUL_BETEND_DAMHANE"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <DataGrid x:Name="dgCommandeCP"   IsReadOnly="True" ItemsSource="{Binding LesCommandes}"  Margin="100,261,100,0" AutoGenerateColumns="False" BorderBrush="Black" Background="{x:Null}" Height="215" Width ="600" VerticalAlignment="Top"    >
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nom client" Binding="{Binding UnClient.Nom, ValidatesOnExceptions=true}" Width="*"/>
                <DataGridTextColumn Header="Date_retrait" Binding="{Binding Date_retrait, ValidatesOnExceptions=true}" Width="*"/>
                <DataGridTextColumn Header="Catégorie événement" Binding="{Binding UneCategorie_evenement.Categorie_evenement_nom, ValidatesOnExceptions=true}" Width="200"/>
                <DataGridTextColumn Header="Statut" Binding="{Binding Est_prete, ValidatesOnExceptions=true}" Width="*"/>

            </DataGrid.Columns>
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#FF1E1E1E"/>
                    <Setter Property="Foreground" Value="#FFF5E6D3"/>
                    <Setter Property="FontFamily" Value="Garamond"/>
                    <Setter Property="FontSize" Value="20"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>


                </Style>
            </DataGrid.ColumnHeaderStyle>

        </DataGrid>
        <Rectangle x:Name="rectFondBandeauOnglet" HorizontalAlignment="Center" Height="41" VerticalAlignment="Top" Width="800" Fill="#FF1E1E1E" Margin="0,74,0,0"/>
        <Button x:Name="butOngletCommandes" Content="Commandes" HorizontalAlignment="Left" Margin="271,85,0,0" VerticalAlignment="Top" Background="Transparent" FontFamily="Garamond" Foreground="#FFF5E6D3" BorderBrush="Transparent" FontSize="16" Click="butOngletCommandes_Click"/>
        <Button x:Name="butOngletCatalogue" Content="Catalogue" HorizontalAlignment="Left" Margin="461,85,0,0" VerticalAlignment="Top" Background="Transparent" FontFamily="Garamond" Foreground="#FFF5E6D3" BorderBrush="Transparent" FontSize="16" />
        <TextBox x:Name="txtboxRecherche" HorizontalAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Top" Width="348" Foreground="#FF737171" FontFamily="Garamond" Height="28" FontSize="24" TextAlignment="Justify" Margin="0,171,0,0"/>
        <Button x:Name="butLogOut"  HorizontalAlignment="Left" Margin="765,80,0,0" VerticalAlignment="Top" Height="30" Width="24" BorderBrush="{x:Null}" RenderTransformOrigin="0.417,0.425" Click="butLogOut_Click">
            <Button.Background>
                <ImageBrush ImageSource="/se-deconnecter.png"/>
            </Button.Background>
        </Button>
        <Image x:Name="iconUtilisateur" Margin="0,10,10,0" Source="/Icon/utilisateur.png" HorizontalAlignment="Right" Width="50" Height="50" VerticalAlignment="Top"/>
        <Label x:Name="labNomUtilisateur" Content="Un nom" HorizontalAlignment="Left" Margin="740,56,0,0" VerticalAlignment="Top" Background="{x:Null}" Foreground="#FFF5E6D3" FontFamily="Garamond"/>

    </Grid>
</UserControl>
