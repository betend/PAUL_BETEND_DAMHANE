<Window x:Class="PAUL_BETEND_DAMHANE.FormDetailProduitCP"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PAUL_BETEND_DAMHANE"
        mc:Ignorable="d"
        Title="FormDetailProduitCP" Height="450" Width="800" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderThickness="0,0,0,2" BorderBrush="#FF737171" Margin="0,0,0,15" Padding="0,0,0,5">
            <TextBlock Text="{Binding UneRecette.Recette_nom, FallbackValue='Nom du produit'}" 
                       FontSize="20" FontWeight="Bold" Foreground="#FF333333" FontFamily="Garamond"/>
        </Border>

        <StackPanel Grid.Row="1" Margin="5,0,5,0">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="Catégorie : " FontWeight="Bold" Width="140" Foreground="#FF555555" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding UneRecette.UneCategorie.Categorie_nom, FallbackValue='N/A'}" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="Prix Unitaire (€) : " FontWeight="Bold" Width="140" Foreground="#FF555555" VerticalAlignment="Center"/>
                <TextBox Text="{Binding Prix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100" Padding="3"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="Format / Parts : " FontWeight="Bold" Width="140" Foreground="#FF555555" VerticalAlignment="Center"/>
                <TextBox Text="{Binding Nb_parts, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100" Padding="3"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="Statut Rupture : " FontWeight="Bold" Width="140" Foreground="#FF555555" VerticalAlignment="Center"/>
                <CheckBox Content="Rendre ce produit indisponible" 
                          IsChecked="{Binding Est_indisponible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                          VerticalAlignment="Center" Foreground="#B22222" />
            </StackPanel>

            <TextBlock Text="Description / Composition (Non modifiable) :" FontWeight="Bold" Margin="0,5,0,5" Foreground="#FF555555"/>
            <TextBox Text="{Binding UneRecette.Recette_description, FallbackValue='Aucune description disponible.'}" 
                     TextWrapping="Wrap" IsReadOnly="True" Height="70" VerticalScrollBarVisibility="Auto" 
                     Background="#FFF1F1F1" Padding="5" BorderBrush="#FFDCDCDC"/>

        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="btnEnregistrer" Content="Enregistrer" 
                    Width="110" Height="30" Margin="0,0,10,0" 
                    Click="btnEnregistrer_Click" Background="#4CAF50" Foreground="White" FontWeight="Bold"/>
            <Button x:Name="btnAnnuler" Content="Annuler" 
                    Width="80" Height="30" Click="btnAnnuler_Click" Background="#FF737171" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
