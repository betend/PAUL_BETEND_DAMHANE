<UserControl x:Class="PAUL_BETEND_DAMHANE.UCCréerFicheClientV"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PAUL_BETEND_DAMHANE"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel>



        <Grid Grid.RowSpan="2" Grid.ColumnSpan="2">
            <Rectangle x:Name="rectFondBandeauOnglet" HorizontalAlignment="Center" Height="41" VerticalAlignment="Top" Width="800" Fill="#FF1E1E1E" Margin="0,74,0,0"/>
            <Label x:Name="labOngletAccueil" Content="Accueil" HorizontalAlignment="Left" Margin="215,82,0,0" VerticalAlignment="Top" Background="{x:Null}" Foreground="#FFF5E6D3" FontFamily="Garamond" FontSize="16"/>
            <Label x:Name="labOngletCatalogue" Content="Catalogue" HorizontalAlignment="Center" Margin="0,82,0,0" VerticalAlignment="Top" Background="{x:Null}" Foreground="#FFF5E6D3" FontFamily="Garamond" FontSize="16"/>
            <Label x:Name="labOngletCommandes" Content="Commande" HorizontalAlignment="Left" Margin="524,82,0,0" VerticalAlignment="Top" Background="{x:Null}" Foreground="#FFF5E6D3" FontFamily="Garamond" FontSize="16"/>
            <Button x:Name="butLogOut"  HorizontalAlignment="Left" Margin="765,80,0,0" VerticalAlignment="Top" Height="30" Width="24" BorderBrush="{x:Null}" RenderTransformOrigin="0.417,0.425" Click="butLogOut_Click" ToolTip="Se déconnecter">
                <Button.Background>
                    <ImageBrush ImageSource="/se-deconnecter.png"/>
                </Button.Background>
            </Button>
            <Image x:Name="iconUtilisateur" Margin="0,10,10,0" Source="/Icon/utilisateur.png" Stretch="Fill" HorizontalAlignment="Right" Width="50" Height="50" VerticalAlignment="Top"/>
            <Label x:Name="labNomUtilisateur" Content="Un nom" HorizontalAlignment="Left" Margin="740,56,0,0" VerticalAlignment="Top" Background="{x:Null}" Foreground="#FFF5E6D3" FontFamily="Garamond"/>

        </Grid>
        <Label Content="Créer une fiche client" Width="310" HorizontalAlignment="Center" Margin="0,20,0,0" FontSize="36" FontFamily="Garamond" />

        <Grid x:Name="gridUCCréerFicheClient" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel  Grid.Column="0" >
                <Label Content="Nom"   Margin="40,20,0,0"  Grid.Row="1" VerticalAlignment="Top" Width="138" />
                <TextBox TextWrapping="Wrap" Text="" Margin="100,0,0,0" Width="190"  Grid.Row="1" Height="25"/>
                <Label Content="Mail"  Margin="40,20,0,0" HorizontalAlignment="center"  Grid.Row="1" VerticalAlignment="Top" Width="138" />
                <TextBox TextWrapping="Wrap" Text="" Margin="100,0,0,0" Width="190" Height="25" Grid.Row="1"/>
            </StackPanel>
            <StackPanel  Grid.Column="1" >
                <Label Content="Prénom" Width="138"  Margin="-160,20,0,0" />
                <TextBox TextWrapping="Wrap" Text=""   Margin="-100,0,0,0" Width="190"  Grid.Row="1" Height="25"/>
                <Label Content="Téléphone" HorizontalAlignment="center" Margin="-160,20,0,0"  Grid.Row="1" VerticalAlignment="Top" Width="138" />
                <TextBox TextWrapping="Wrap" Height="25" Text=""  Width="190"  Margin="-100,0,0,0" Grid.Row="1"/>
            </StackPanel>
        </Grid>
        <Button Content="Créer" Margin="0,40,0,0"  Height="38" Width="168" Background="Black" Foreground="White"/>

    </StackPanel>
</UserControl>
