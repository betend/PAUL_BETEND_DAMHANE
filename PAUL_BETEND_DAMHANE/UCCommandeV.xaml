<UserControl x:Class="PAUL_BETEND_DAMHANE.UCCommandeV"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PAUL_BETEND_DAMHANE"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Loaded="UserControl_Loaded">
    <Grid>
        <Rectangle x:Name="rectFondBandeauOnglet" HorizontalAlignment="Center" Height="41" VerticalAlignment="Top" Width="800" Fill="#FF1E1E1E" Margin="0,74,0,0"/>
        <Button x:Name="butOngletCommandes" Content="Commandes" HorizontalAlignment="Left" Margin="202,85,0,0" VerticalAlignment="Top" Background="Transparent" FontFamily="Garamond" Foreground="#FFF5E6D3" BorderBrush="Transparent" FontSize="16" Click="butOngletCommandes_Click"/>
        <Button x:Name="butOngletCatalogue" Content="Catalogue" HorizontalAlignment="Center" Margin="0,85,0,0" VerticalAlignment="Top" Background="Transparent" FontFamily="Garamond" Foreground="#FFF5E6D3" BorderBrush="Transparent" FontSize="16" Click="butOngletCatalogue_Click"/>
        <Button x:Name="butOngletPanier" Content="Panier" HorizontalAlignment="Left" Margin="522,85,0,0" VerticalAlignment="Top" Background="Transparent" FontFamily="Garamond" Foreground="#FFF5E6D3" BorderBrush="Transparent" FontSize="16" Click="butOngletPanier_Click"/>
        <TextBox x:Name="txtboxRecherche" HorizontalAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Top" Width="348" Foreground="#FF737171" FontFamily="Garamond" Height="28" FontSize="24" TextAlignment="Justify"  TextChanged="textMotClefCommande_TextChanged" Margin="0,171,0,0" ToolTip="Rechercher"/>
        <Button x:Name="butLogOut"  HorizontalAlignment="Left" Margin="765,80,0,0" VerticalAlignment="Top" Height="30" Width="24" BorderBrush="{x:Null}" RenderTransformOrigin="0.417,0.425" Click="butLogOut_Click">
            <Button.Background>
                <ImageBrush ImageSource="/se-deconnecter.png"/>
            </Button.Background>
        </Button>
        <Image x:Name="iconUtilisateur" Margin="0,10,10,0" Source="/Icon/utilisateur.png" HorizontalAlignment="Right" Width="50" Height="50" VerticalAlignment="Top"/>

        <DataGrid x:Name="dgCommandeV"   IsReadOnly="True" ItemsSource="{Binding LesCommandes}"  Margin="189,271,111,0" AutoGenerateColumns="False" BorderBrush="Black" Background="{x:Null}" Height="215" Width ="500" VerticalAlignment="Top"    >
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nom client" Binding="{Binding UnClient.Nom, ValidatesOnExceptions=true}" Width="*"/>
                <DataGridTextColumn Header="Date_retrait" Binding="{Binding Date_retrait, ValidatesOnExceptions=true}" Width="*"/>
                <DataGridTextColumn Header="Catégorie" Binding="{Binding UneCategorie_evenement.Categorie_evenement_nom, ValidatesOnExceptions=true}" Width="*"/>
                <DataGridTextColumn Header="Statut" Binding="{Binding Est_recuperee, ValidatesOnExceptions=true}" Width="*"/>
                <DataGridTemplateColumn Header="Recuperee" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox x:Name="checkValiderCommande" IsChecked="{Binding Est_recuperee, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Content="Valider" HorizontalAlignment="Center" VerticalAlignment="Center" Click="checkValiderCommande_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#FF1E1E1E"/>
                    <Setter Property="Foreground" Value="#FFF5E6D3"/>
                    <Setter Property="FontFamily" Value="Garamond"/>
                    <Setter Property="FontSize" Value="20"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>


                </Style>
            </DataGrid.ColumnHeaderStyle>

        </DataGrid>
        <Label x:Name="labTitreCommandeV" Content="Visualiser les commandes à restituer" HorizontalAlignment="Center" Margin="0,133,0,0" VerticalAlignment="Top" Background="{x:Null}" Foreground="Black" FontFamily="Georgia" FontSize="20"/>
        <Button x:Name="butMofifierStatut" Content="&#xE104;" HorizontalAlignment="Left" Margin="740,309,0,0" VerticalAlignment="Top" FontFamily="Segoe MDL2 Assets" Background="#FF1E1E1E" Foreground="#FFF5E6D3" Height="28" Width="32"/>
        <RadioButton x:Name="rbToutes" Content="Toutes" HorizontalAlignment="Left" Margin="39,215,0,0" VerticalAlignment="Top" Checked="RadioFiltre_Checked"/>
        <RadioButton x:Name="rbRecuperees" Content="Récupérées" HorizontalAlignment="Left" Margin="39,237,0,0" VerticalAlignment="Top" Checked="RadioFiltre_Checked"/>
        <RadioButton x:Name="rbNonRecuperees" Content="Non récupérées" HorizontalAlignment="Left" Margin="39,257,0,0" VerticalAlignment="Top" Checked="RadioFiltre_Checked"/>

        <CheckBox x:Name="chkMariage" Content="Mariage" HorizontalAlignment="Left" Margin="226,215,0,0" VerticalAlignment="Top" FontFamily="Garamond" FontSize="14" Checked="CheckBox_Click" Unchecked="CheckBox_Click"/>
        <CheckBox x:Name="chkAnniversaire" Content="Anniversaire" HorizontalAlignment="Left" Margin="226,238,0,0" VerticalAlignment="Top" FontFamily="Garamond" FontSize="14" Checked="CheckBox_Click" Unchecked="CheckBox_Click"/>
        <CheckBox x:Name="chkBapteme" Content="Baptême" HorizontalAlignment="Left" Margin="322,215,0,0" VerticalAlignment="Top" FontFamily="Garamond" FontSize="14" Checked="CheckBox_Click" Unchecked="CheckBox_Click"/>
        <CheckBox x:Name="chkNaissance" Content="Naissance" HorizontalAlignment="Left" Margin="322,238,0,0" VerticalAlignment="Top" FontFamily="Garamond" FontSize="14" Checked="CheckBox_Click" Unchecked="CheckBox_Click"/>
        <CheckBox x:Name="chkReunion" Content="Réunion" HorizontalAlignment="Left" Margin="417,214,0,0" VerticalAlignment="Top" FontFamily="Garamond" FontSize="14" Checked="CheckBox_Click" Unchecked="CheckBox_Click"/>
        <CheckBox x:Name="chkPotDepart" Content="Pot de départ" HorizontalAlignment="Left" Margin="417,238,0,0" VerticalAlignment="Top" FontFamily="Garamond" FontSize="14" Checked="CheckBox_Click" Unchecked="CheckBox_Click"/>
        <CheckBox x:Name="chkPortesOuvertes" Content="Portes ouvertes" HorizontalAlignment="Left" Margin="530,214,0,0" VerticalAlignment="Top" FontFamily="Garamond" FontSize="14" Checked="CheckBox_Click" Unchecked="CheckBox_Click"/>
        <CheckBox x:Name="chkFeteReligieuse" Content="Fête religieuse" HorizontalAlignment="Left" Margin="530,238,0,0" VerticalAlignment="Top" FontFamily="Garamond" FontSize="14" Checked="CheckBox_Click" Unchecked="CheckBox_Click"/>
        <CheckBox x:Name="chkSeminaire" Content="Séminaire" HorizontalAlignment="Left" Margin="661,214,0,0" VerticalAlignment="Top" FontFamily="Garamond" FontSize="14" Checked="CheckBox_Click" Unchecked="CheckBox_Click"/>
        <CheckBox x:Name="chkBuffetEntreprise" Content="Buffet entreprise" HorizontalAlignment="Left" Margin="661,238,0,0" VerticalAlignment="Top" FontFamily="Garamond" FontSize="14" Checked="CheckBox_Click" Unchecked="CheckBox_Click"/>


        <DatePicker x:Name="dpDateRecherche" HorizontalAlignment="Left" VerticalAlignment="Top" Width="165" Height="28" Margin="600,171,0,0" FontFamily="Garamond" FontSize="14" SelectedDateChanged="dpDateRecherche_SelectedDateChanged"/>
    </Grid>
</UserControl>
