<UserControl x:Class="PAUL_BETEND_DAMHANE.UCAuthentification"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PAUL_BETEND_DAMHANE"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid x:Name="gridAuthentification">
        <StackPanel x:Name="spAuthentification" Margin="0,55,0,0">
            <Label x:Name="labConnexion" Content="Connexion à votre session" HorizontalAlignment="Center" FontSize="36" FontFamily="Georgia" Margin="0,20,0,0"/>
            <Label x:Name="labLogin" Content="Login" FontFamily="Garamond" Margin="300,20,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <TextBox x:Name="txtboxLogin" TextWrapping="Wrap" Text="" Width="200" Height="25" FontFamily="Garamond" Margin="0,10,0,0"/>
            <Label x:Name="labPassword" Content="Password" FontFamily="Garamond" Margin="300,20,0,0"/>
            <PasswordBox x:Name="txtboxPassword" Width="200" FontFamily="Garamond" Margin="0,10,0,0" Height="25"/>
            <Button x:Name="butConnexion" Content="Connexion" FontFamily="Garamond" Background="#FF020000" BorderBrush="Black" Foreground="White" HorizontalAlignment="Center" Margin="0,50,0,0" Width="113" Height="26" Click="butConnexion_Click"/>
        </StackPanel>


    </Grid>
</UserControl>
