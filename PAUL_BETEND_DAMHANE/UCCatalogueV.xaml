<UserControl x:Class="PAUL_BETEND_DAMHANE.UCCatalogueV"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PAUL_BETEND_DAMHANE"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Loaded="UserControl_Loaded" >
    <Grid x:Name="gridUCCatalogue" OpacityMask="Black">
        <Rectangle x:Name="rectFondBandeauOnglet" HorizontalAlignment="Center" Height="41" VerticalAlignment="Top" Width="800" Fill="#FF1E1E1E" Margin="0,74,0,0"/>
        <Button x:Name="butOngletCommandes" Content="Commandes" HorizontalAlignment="Left" Margin="202,85,0,0" VerticalAlignment="Top" Background="Transparent" FontFamily="Garamond" Foreground="#FFF5E6D3" BorderBrush="Transparent" FontSize="16" Click="butOngletCommandes_Click"/>
        <Button x:Name="butOngletCatalogue" Content="Catalogue" HorizontalAlignment="Center" Margin="0,85,0,0" VerticalAlignment="Top" Background="Transparent" FontFamily="Garamond" Foreground="#FFF5E6D3" BorderBrush="Transparent" FontSize="16" Click="butOngletCatalogue_Click"/>
        <Button x:Name="butOngletPanier" Content="Panier" HorizontalAlignment="Left" Margin="522,85,0,0" VerticalAlignment="Top" Background="Transparent" FontFamily="Garamond" Foreground="#FFF5E6D3" BorderBrush="Transparent" FontSize="16" Click="butOngletPanier_Click"/>
        <Image x:Name="iconUtilisateur" Margin="0,10,10,0" Source="/Icon/utilisateur.png" Stretch="Fill" HorizontalAlignment="Right" Width="50" Height="50" VerticalAlignment="Top"/>
        <Label x:Name="labNomUtilisateur" Content="Un nom" HorizontalAlignment="Left" Margin="740,56,0,0" VerticalAlignment="Top" Background="{x:Null}" Foreground="#FFF5E6D3" FontFamily="Garamond"/>
        <TextBox x:Name="txtboxRecherche" HorizontalAlignment="Left" Margin="102,205,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="348" Foreground="#FF737171" FontFamily="Garamond" Height="28" FontSize="24" TextAlignment="Justify" TextChanged="textMotClefProduit_TextChanged" ToolTip="Rechercher"/>
        <Button x:Name="butAjouterAuPanier" Content="Ajouter au panier" HorizontalAlignment="Left" Margin="516,206,0,0" VerticalAlignment="Top" Background="#FF1E1E1E" FontFamily="Garamond" Foreground="#FFF5E6D3" BorderBrush="Transparent" FontSize="16" Click="butAjouterAuPanier_Click" Width="134"/>

        <DataGrid x:Name="dgProduits"   IsReadOnly="True" ItemsSource="{Binding LesProduits}"  Margin="53,300,44,0" Width="700" AutoGenerateColumns="False" BorderBrush="Black" Background="{x:Null}" Height="215" VerticalAlignment="Top"   >
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nom" Binding="{Binding UneRecette.Recette_nom, ValidatesOnExceptions=true}" Width="*"/>
                <DataGridTextColumn Header="Prix" Binding="{Binding Prix, ValidatesOnExceptions=true}" Width="*"/>
                <DataGridTextColumn Header="Nb Parts" Binding="{Binding Nb_parts, ValidatesOnExceptions=true}" Width="*"/>
                <DataGridTextColumn Header="Allergenes" Binding="{Binding AllergeneTexte, ValidatesOnExceptions=true}" Width="*"/>
                <DataGridTextColumn Header="Categorie" Binding="{Binding UneRecette.UneCategorie.Categorie_nom, ValidatesOnExceptions=true}" Width="*"/>

            </DataGrid.Columns>
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#FF1E1E1E"/>
                    <Setter Property="Foreground" Value="#FFF5E6D3"/>
                    <Setter Property="FontFamily" Value="Garamond"/>
                    <Setter Property="FontSize" Value="20"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>


                </Style>
            </DataGrid.ColumnHeaderStyle>

        </DataGrid>
        <Image x:Name="iconLoupe" Margin="0,210,359,0" Source="/Icon/loupe.png" Stretch="Fill" HorizontalAlignment="Right" Width="17" Height="18" VerticalAlignment="Top"/>
        <Label x:Name="labTitreCatalogue" Content="Visualiser le catalogue de produits" HorizontalAlignment="Center" Margin="0,139,0,0" VerticalAlignment="Top" Background="{x:Null}" Foreground="Black" FontFamily="Georgia" FontSize="30"/>
        <Button x:Name="butLogOut"  HorizontalAlignment="Left" Margin="765,80,0,0" VerticalAlignment="Top" Height="30" Width="24" BorderBrush="{x:Null}" RenderTransformOrigin="0.417,0.425" Click="butLogOut_Click">
            <Button.Background>
                <ImageBrush ImageSource="/se-deconnecter.png"/>
            </Button.Background>
        </Button>
        <ComboBox x:Name="cboCategorie" HorizontalAlignment="Left" Margin="112,253,0,0" VerticalAlignment="Top" Width="120" SelectionChanged="cboCategorie_SelectionChanged" >
            <ComboBoxItem Content="Toutes"/>
            <ComboBoxItem Content="Pain"/>
            <ComboBoxItem Content="Viennoiserie"/>
            <ComboBoxItem Content="Gateau"/>
            <ComboBoxItem Content="Sale"/>
        </ComboBox>
        <CheckBox x:Name="chkFruitsACoque" Content="Fruits à coque" HorizontalAlignment="Left" Margin="328,242,0,0" VerticalAlignment="Top" FontFamily="Garamond" FontSize="14" Click="Allergene_Click"/>
        <CheckBox x:Name="chkGluten" Content="Gluten" HorizontalAlignment="Left" Margin="328,264,0,0" VerticalAlignment="Top" FontFamily="Garamond" FontSize="14" Click="Allergene_Click"/>
        <CheckBox x:Name="chkLait" Content="Lait" HorizontalAlignment="Left" Margin="456,242,0,0" VerticalAlignment="Top" FontFamily="Garamond" FontSize="14" Click="Allergene_Click"/>
        <CheckBox x:Name="chkOeuf" Content="Oeuf" HorizontalAlignment="Left" Margin="456,264,0,0" VerticalAlignment="Top" FontFamily="Garamond" FontSize="14" Click="Allergene_Click"/>
        <CheckBox x:Name="chkSesame" Content="Sesame" HorizontalAlignment="Left" Margin="532,242,0,0" VerticalAlignment="Top" FontFamily="Garamond" FontSize="14" Click="Allergene_Click"/>
        <CheckBox x:Name="chkSoja" Content="Soja" HorizontalAlignment="Left" Margin="532,264,0,0" VerticalAlignment="Top" FontFamily="Garamond" FontSize="14" Click="Allergene_Click"/>
        <CheckBox x:Name="chkSulfites" Content="Sulfites" HorizontalAlignment="Left" Margin="620,242,0,0" VerticalAlignment="Top" FontFamily="Garamond" FontSize="14" Click="Allergene_Click"/>
        <Label Content="Catégorie" HorizontalAlignment="Left" Margin="53,252,0,0" VerticalAlignment="Top" FontFamily="Garamond"/>
        <Label Content="Allergènes" HorizontalAlignment="Left" Margin="254,237,0,0" VerticalAlignment="Top" FontFamily="Garamond"/>

    </Grid>
</UserControl>

