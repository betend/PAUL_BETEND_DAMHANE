<Window x:Class="PAUL_BETEND_DAMHANE.FormAjoutProduitCP"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PAUL_BETEND_DAMHANE"
        mc:Ignorable="d"
        Title="FormAjoutProduitCP" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="black">
            <TextBlock Text="Ajouter un nouveau produit" Foreground="White" FontWeight="Bold" FontSize="16" FontFamily="Garamond" VerticalAlignment="Center" Margin="15,0,0,0"/>
            
        </Grid>

        <StackPanel Grid.Row="1" Margin="25,20,25,0">

            <TextBlock Text="Nom du produit :" FontWeight="Bold" Foreground="black" Margin="0,0,0,5" FontFamily="Garamond"/>
            <TextBox x:Name="txtNomProduit" Height="30" Margin="0,0,0,15" Padding="5" VerticalContentAlignment="Center"/>

            <TextBlock Text="Catégorie du produit :" FontWeight="Bold" Foreground="black" Margin="0,0,0,5" FontFamily="Garamond"/>
            <ComboBox x:Name="cboCategories" DisplayMemberPath="Categorie_nom" Height="30" Margin="0,0,0,15" VerticalContentAlignment="Center"/>

            <TextBlock Text="Prix Unitaire (€) :" FontWeight="Bold" Foreground="black" Margin="0,0,0,5" FontFamily="Garamond"/>
            <TextBox x:Name="txtPrix" Height="30" Margin="0,0,0,15" Padding="5" VerticalContentAlignment="Center"/>

            <TextBlock Text="Nombre de parts (Format) :" FontWeight="Bold" Foreground="black" Margin="0,0,0,5" FontFamily="Garamond"/>
            <TextBox x:Name="txtNbParts" Height="30" Margin="0,0,0,15" Padding="5" VerticalContentAlignment="Center"/>

            <CheckBox x:Name="chkIndisponible" Content="Rendre ce produit immédiatement indisponible (Rupture)" Margin="0,5,0,0" FontFamily="Garamond"/>

        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,25,20">
            <Button x:Name="btnValider" Content="Créer le produit" Width="130" Height="32" Margin="0,0,10,0" Background="#4CAF50" Foreground="White" FontWeight="Bold" FontFamily="Garamond"/>
            <Button x:Name="btnAnnuler" Content="Annuler" Width="80" Height="32" Click="btnAnnuler_Click" Background="black" Foreground="White" FontFamily="Garamond"/>
        </StackPanel>
    </Grid>
</Window>
